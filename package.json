{
  "name": "the-food-tracker-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:static": "vite build --config vite.static.config.ts",
    "preview:static": "vite preview --config vite.static.config.ts",
    "deploy:cf": "npm run build && node scripts/patch-deploy-config.mjs && wrangler deploy",
    "start": "vinext start",
    "test": "node --test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-static --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.9",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.0",
    "wrangler": "^4.105.0"
  },
  "type": "module",
  "overrides": {
    "postcss": "^8.5.10",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
